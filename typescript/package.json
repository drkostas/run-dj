{
  "name": "run-dj",
  "version": "0.6.0",
  "description": "Pure core of Soma's running DJ: HR-to-BPM formula, anti-clustering shuffle, playlist scoring, the live queue decision, genre buckets, and the ReccoBeats and Spotify clients over injectable I/O.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bpm-formula": {
      "types": "./dist/bpm-formula.d.ts",
      "default": "./dist/bpm-formula.js"
    },
    "./dj-shuffle": {
      "types": "./dist/dj-shuffle.d.ts",
      "default": "./dist/dj-shuffle.js"
    },
    "./playlist-algorithm": {
      "types": "./dist/playlist-algorithm.d.ts",
      "default": "./dist/playlist-algorithm.js"
    },
    "./cycle": {
      "types": "./dist/cycle.d.ts",
      "default": "./dist/cycle.js"
    },
    "./genre": {
      "types": "./dist/genre.d.ts",
      "default": "./dist/genre.js"
    },
    "./reccobeats": {
      "types": "./dist/reccobeats.d.ts",
      "default": "./dist/reccobeats.js"
    },
    "./spotify": {
      "types": "./dist/spotify.d.ts",
      "default": "./dist/spotify.js"
    },
    "./segments": {
      "types": "./dist/segments.d.ts",
      "default": "./dist/segments.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "dj",
    "running",
    "bpm",
    "cadence",
    "playlist",
    "spotify",
    "shuffle",
    "soma"
  ],
  "author": "drkostas <georgiou.kostas94@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drkostas/run-dj.git",
    "directory": "typescript"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
